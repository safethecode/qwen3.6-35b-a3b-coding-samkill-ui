{
  "rules": [
    {
      "id": "mobile-width",
      "kind": "maxWidth",
      "subject": "body",
      "maximum": 390
    },
    {
      "id": "groups-after-week",
      "kind": "below",
      "subject": "[data-ui-unit=\"tasks\"]",
      "reference": "[data-ui-unit=\"week\"]",
      "minGap": 0
    },
    {
      "id": "heading-actions",
      "kind": "sameRow",
      "subject": "#selected-date",
      "reference": "#edit-tasks",
      "tolerance": 2
    },
    {
      "id": "heading-separation",
      "kind": "disjoint",
      "subject": "#selected-date",
      "reference": "#edit-tasks"
    },
    {
      "id": "task-check-first-line",
      "kind": "firstLineControls",
      "subject": "[data-ui-unit=\"tasks\"]",
      "rows": ".task-row",
      "text": ".task-name",
      "controls": [
        ".task-check"
      ],
      "tolerance": 2
    },
    {
      "id": "quiet-reading",
      "kind": "absent",
      "subject": ".delete-task:not([hidden])",
      "states": [
        "reading"
      ]
    },
    {
      "id": "editing-action-first-line",
      "kind": "firstLineControls",
      "subject": "[data-ui-unit=\"tasks\"]",
      "rows": ".task-row",
      "text": ".task-name",
      "controls": [
        ".task-check",
        ".delete-task"
      ],
      "tolerance": 2,
      "states": [
        "editing"
      ]
    }
  ]
}