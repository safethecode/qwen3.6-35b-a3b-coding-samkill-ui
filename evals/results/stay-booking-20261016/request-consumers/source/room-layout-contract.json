{
  "rules": [
    {
      "id": "bounded-mobile",
      "kind": "maxWidth",
      "subject": "body",
      "maximum": 390
    },
    {
      "id": "wide-compact-first-room-photo",
      "kind": "computedStyle",
      "subject": ".room-card[data-room-id=\"afternoon-standard\"] .room-photo",
      "properties": {
        "aspect-ratio": "11 / 5",
        "object-fit": "cover"
      },
      "states": [
        "rooms",
        "selected"
      ]
    },
    {
      "id": "room-metadata-below-photo",
      "kind": "below",
      "subject": ".room-card[data-room-id=\"afternoon-standard\"] .room-card-content",
      "reference": ".room-card[data-room-id=\"afternoon-standard\"] .room-photo",
      "minGap": 0,
      "states": [
        "rooms",
        "selected"
      ]
    },
    {
      "id": "price-below-room-facts",
      "kind": "below",
      "subject": ".room-card[data-room-id=\"afternoon-standard\"] .room-price",
      "reference": ".room-card[data-room-id=\"afternoon-standard\"] .room-facts",
      "minGap": 16,
      "states": [
        "rooms",
        "selected"
      ]
    },
    {
      "id": "separate-room-cards",
      "kind": "below",
      "subject": ".room-card[data-room-id=\"afternoon-family\"]",
      "reference": ".room-card[data-room-id=\"afternoon-standard\"]",
      "minGap": 24,
      "states": [
        "rooms",
        "selected"
      ]
    },
    {
      "id": "closed-native-dialogs-stay-hidden",
      "kind": "absent",
      "subject": "dialog:not([open]):visible"
    },
    {
      "id": "specific-firstroom-bed-focalpoint",
      "kind": "computedStyle",
      "subject": ".room-card[data-room-id=\"afternoon-standard\"] .room-photo",
      "properties": {
        "object-position": "50% 100%"
      },
      "states": [
        "rooms",
        "selected"
      ]
    },
    {
      "id": "review-return-leading-edge",
      "kind": "computedStyle",
      "subject": "#review-back",
      "properties": {
        "align-self": "flex-start"
      },
      "states": [
        "review"
      ]
    },
    {
      "id": "selected-native-radio-surface",
      "kind": "computedStyle",
      "subject": ".rate-option:has(input:checked)",
      "properties": {
        "background-color": "rgb(255, 255, 255)",
        "box-shadow": "rgb(34, 33, 38) 0px 0px 0px 2px inset"
      },
      "states": [
        "rate-selected"
      ]
    },
    {
      "id": "C1-room-leading-target",
      "kind": "computedStyle",
      "subject": ".room-topbar",
      "states": [
        "rooms",
        "selected"
      ],
      "properties": {
        "margin-left": "-20px",
        "margin-right": "-20px"
      }
    },
    {
      "id": "C1-room-task-card-role",
      "kind": "computedStyle",
      "subject": "#detail-title",
      "states": [
        "rooms",
        "selected"
      ],
      "properties": {
        "font-size": "18px",
        "font-weight": "600"
      },
      "modes": [
        "normal"
      ]
    },
    {
      "id": "related-title-icon-afternoon-standard",
      "kind": "sameRow",
      "subject": ".room-card[data-room-id=\"afternoon-standard\"] [data-room-name]",
      "reference": ".room-card[data-room-id=\"afternoon-standard\"] .room-title-button img",
      "tolerance": 1,
      "states": [
        "rooms",
        "selected"
      ]
    },
    {
      "id": "related-title-icon-afternoon-family",
      "kind": "sameRow",
      "subject": ".room-card[data-room-id=\"afternoon-family\"] [data-room-name]",
      "reference": ".room-card[data-room-id=\"afternoon-family\"] .room-title-button img",
      "tolerance": 1,
      "states": [
        "rooms",
        "selected"
      ]
    },
    {
      "id": "room-task-card-relative-emphasis",
      "kind": "typeRelation",
      "subject": "#detail-title",
      "reference": ".room-card[data-room-id=\"afternoon-standard\"] [data-room-name]",
      "minSizeRatio": 1,
      "maxSizeRatio": 1,
      "minWeightDifference": 0,
      "maxWeightDifference": 0,
      "states": [
        "rooms",
        "selected"
      ]
    },
    {
      "id": "listing-price-subordinate-afternoon-standard",
      "kind": "typeRelation",
      "subject": ".room-card[data-room-id=\"afternoon-standard\"] .room-price strong",
      "reference": ".room-card[data-room-id=\"afternoon-standard\"] [data-room-name]",
      "minSizeRatio": 0.8,
      "maxSizeRatio": 0.9,
      "minWeightDifference": 0,
      "maxWeightDifference": 0,
      "states": [
        "rooms",
        "selected"
      ]
    },
    {
      "id": "listing-price-subordinate-afternoon-family",
      "kind": "typeRelation",
      "subject": ".room-card[data-room-id=\"afternoon-family\"] .room-price strong",
      "reference": ".room-card[data-room-id=\"afternoon-family\"] [data-room-name]",
      "minSizeRatio": 0.8,
      "maxSizeRatio": 0.9,
      "minWeightDifference": 0,
      "maxWeightDifference": 0,
      "states": [
        "rooms",
        "selected"
      ]
    }
  ],
  "scope": "Pre-style mechanical relationships only; samewidth direct positive-anchor review remains separate."
}
